# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMS_API_KEY: Fast2SMS API key for real mobile OTP SMS delivery (https://www.fast2sms.com)
SMS_API_KEY=""

# Optional Twilio SMS configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Secret salt for cryptographic OTP hashing
OTP_SECRET_SALT="vedic_wisdom_secure_salt_2026"
